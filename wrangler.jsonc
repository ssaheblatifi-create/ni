{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ni",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b4a2d046-09a3-4d5b-b1e2-b3a7b83b3980","database_name": "nikadb1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b633eae8076c43a5b9e8a14096fb8c32" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
